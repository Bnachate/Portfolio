# Copy this file to .env.local and fill in the values.

# PostgreSQL connection string. Leave empty in local dev to use the embedded PGlite database (./.pglite).
# In production (Vercel), use the pooled connection string of your provider (Neon, Supabase, Railway...).
DATABASE_URL=

# Secret used to sign session cookies. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional: email notification for each new contact message (https://resend.com, free tier).
# Without RESEND_API_KEY, messages are only visible in the admin panel.
RESEND_API_KEY=
# Recipient. Defaults to the contact email saved in the admin Hero tab.
CONTACT_NOTIFY_EMAIL=
# Sender. Defaults to Resend's test sender, which can only email the address of your Resend account.
# Use an address on a domain verified in Resend to send elsewhere.
CONTACT_FROM_EMAIL=
